# ── Copy this file to .env and fill in your values ────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...

# JWT secrets — generate strong random strings (≥32 chars each)
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET_KEY=replace-with-another-long-random-secret-here

# Token expiry (seconds)
ACCESS_TOKEN_EXPIRY=86400          # 24 hours
REFRESH_TOKEN_EXPIRY=604800        # 7 days

# Database
# SQLite (default — no setup required):
DATABASE_URL=sqlite:///./legal_bot.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/legalbot

# FAISS index storage directory
INDEXES_BASE_DIR=./indexes

# File upload limits
MAX_FILE_SIZE_MB=50

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
